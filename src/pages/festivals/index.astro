---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { getData } from '../../lib/db';

const { festivals, venueById } = await getData(env.DB);
const statusLabel: Record<string, string> = {
  announced: '未开售', presale: '预售', on_sale: '售票中',
  sold_out: '售罄', postponed: '延期', cancelled: '取消',
};
const fmt = (d: string) => `${Number(d.slice(5, 7))}/${Number(d.slice(8, 10))}`;
---

<BaseLayout title="音乐节 | lvfind">
  <div class="container page">
    <header class="head">
      <h1 class="display-small">音乐节</h1>
      <p class="body-large muted">拼盘演出 / Festival 专场页面，含逐日完整阵容和票务状态。</p>
    </header>
    <ul class="table">
      {
        festivals.map((f) => {
          const v = venueById[f.venue];
          const acts = f.days.reduce((n, d) => n + d.artists.length, 0);
          return (
            <li>
              <a href={`/festival/${f.slug}`}>
                <md-ripple />
                <span class="name">
                  <b>{f.name}</b>
                  <small>{v?.nameLocal ?? v?.name} · {v?.cityZh} · {f.days.length} 天 · {acts} 组</small>
                </span>
                <span class="date">{fmt(f.startDate)} – {fmt(f.endDate)}</span>
                <span class:list={['status', `status--${f.ticketStatus}`]}>{statusLabel[f.ticketStatus]}</span>
                <span class="material-symbols-rounded arrow">arrow_forward</span>
              </a>
            </li>
          );
        })
      }
      {festivals.length === 0 && <p class="body-medium muted">暂时没有收录的音乐节。</p>}
    </ul>
  </div>
</BaseLayout>

<style>
  .page { padding: var(--lv-space-6) 0 var(--lv-space-10); }
  .head { margin-bottom: var(--lv-space-6); }
  .table { list-style: none; margin: 0; padding: 0; border: 1px solid var(--md-sys-color-outline-variant); border-radius: var(--lv-radius-m); overflow: hidden; }
  .table a { position: relative; display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: var(--lv-space-4); padding: var(--lv-space-4) var(--lv-space-5); text-decoration: none; color: var(--md-sys-color-on-surface); }
  .table li + li { border-top: 1px solid var(--md-sys-color-outline-variant); }
  .table a:hover { background: var(--md-sys-color-surface-container-high); }
  .name small { display: block; color: var(--md-sys-color-on-surface-variant); }
  .date { font: var(--lv-font-label-large); color: var(--md-sys-color-on-surface-variant); font-variant-numeric: tabular-nums; }
  .status { font: var(--lv-font-label-large); padding: 2px 10px; border-radius: var(--lv-shape-full); background: var(--md-sys-color-secondary-container); color: var(--md-sys-color-on-secondary-container); }
  .status--sold_out { background: var(--md-sys-color-error-container); color: var(--md-sys-color-on-error-container); }
  .arrow { color: var(--md-sys-color-on-surface-variant); font-size: 20px; }
  .muted { color: var(--md-sys-color-on-surface-variant); }
</style>
