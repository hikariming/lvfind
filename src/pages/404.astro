---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---

<BaseLayout title="页面不存在 | lvfind">
  <div class="container notfound">
    <div class="shape"><span class="material-symbols-rounded">music_off</span></div>
    <h1 class="display-small">没找到这个页面</h1>
    <p class="body-large muted">链接可能失效了，回首页看看最近的演出吧。</p>
    <md-filled-button href="/">
      <md-icon slot="icon" class="material-symbols-rounded">home</md-icon>回到首页
    </md-filled-button>
  </div>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 96px 0;
    text-align: center;
    gap: 8px;
  }
  .shape {
    display: grid;
    place-items: center;
    width: 120px;
    height: 120px;
    margin-bottom: 16px;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-radius: 40% 60% 55% 45% / 50% 40% 60% 50%;
  }
  .shape .material-symbols-rounded {
    font-size: 56px;
  }
  .notfound h1 {
    margin: 0;
  }
  .muted {
    margin: 0 0 20px;
    color: var(--md-sys-color-on-surface-variant);
  }
</style>
