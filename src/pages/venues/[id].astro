---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventRow from '../../components/EventRow.astro';
import { env } from 'cloudflare:workers';
import { getData, toMapVenue } from '../../lib/db';
import { venueTypes, regions } from '../../data/events';

const { artistBySlug, venueById, venues, events, layoutsByVenue } = await getData(env.DB);
const venue = venues.find((v) => v.id === Astro.params.id);
if (!venue) return Astro.redirect('/404');

const layouts = layoutsByVenue[venue.id] ?? [];
const mainLayout = layouts.reduce<(typeof layouts)[number] | undefined>(
  (best, l) => ((l.seats ?? 0) > (best?.seats ?? 0) ? l : best),
  undefined,
);

const upcoming = events.filter((e) => e.venue === venue.id);
const sameCity = venues.filter((v) => v.citySlug === venue.citySlug && v.id !== venue.id);
const nearby = venues.filter((v) => v.citySlug === venue.citySlug).map(toMapVenue);
const counts = Object.fromEntries(nearby.map((v) => [v.id, events.filter((e) => e.venue === v.id).length]));
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${venue.lat},${venue.lng}`;
---

<BaseLayout title={`${venue.name} · ${venue.cityZh} | lvfind 场馆`}>
  <div class="container page">
    <md-text-button href="/venues" class="back">
      <md-icon slot="icon" class="material-symbols-rounded">arrow_back</md-icon>全部场馆
    </md-text-button>

    <header class="head">
      <span class="type label-large"><span class="material-symbols-rounded">stadium</span>{venueTypes[venue.type]}</span>
      <h1 class="display-small">{venue.name}</h1>
      {venue.nameLocal && <p class="title-medium local">{venue.nameLocal}</p>}
      <p class="body-large where">
        <span class="material-symbols-rounded">location_on</span>
        <a href={`/city/${venue.citySlug}`}>{venue.cityZh}</a> · {regions[venue.countryCode]}
      </p>
    </header>

    <div class="layout">
      <div class="lv-map map" id="venue-map"></div>

      <dl class="facts">
        <div>
          <dt><span class="material-symbols-rounded">groups</span>容量</dt>
          <dd>
            约 {venue.capacity.toLocaleString('zh-CN')} 人
            {layouts.length > 0 && (
              <ul class="seat-layouts">
                {layouts.map((l) => (
                  <li>
                    {l.hallLabel}
                    {l.seats != null && ` ${l.seats.toLocaleString('zh-CN')}席`}
                  </li>
                ))}
              </ul>
            )}
          </dd>
        </div>
        <div>
          <dt><span class="material-symbols-rounded">home_pin</span>地址</dt>
          <dd>{venue.address}</dd>
        </div>
        <div>
          <dt><span class="material-symbols-rounded">train</span>交通</dt>
          <dd>{venue.transit}</dd>
        </div>
        <div>
          <dt><span class="material-symbols-rounded">schedule</span>时区</dt>
          <dd>{venue.timezone} ({venue.tzAbbr})</dd>
        </div>
        <div class="actions">
          <md-filled-tonal-button href={mapsUrl} target="_blank">
            <md-icon slot="icon" class="material-symbols-rounded">directions</md-icon>导航
          </md-filled-tonal-button>
          {
            venue.website && (
              <md-outlined-button href={venue.website} target="_blank">
                <md-icon slot="icon" class="material-symbols-rounded">language</md-icon>官网
              </md-outlined-button>
            )
          }
          {
            mainLayout && (
              <md-outlined-button href={mainLayout.seatmapUrl} target="_blank">
                <md-icon slot="icon" class="material-symbols-rounded">event_seat</md-icon>座位图
              </md-outlined-button>
            )
          }
        </div>
      </dl>
    </div>

    <section class="section">
      <h2 class="headline-small">
        即将举行 <span class="count label-large">{upcoming.length} 场</span>
      </h2>
      {
        upcoming.length ? (
          <div class="events" data-view="list">
            {upcoming.map((e) => (
              <EventRow event={e} artist={artistBySlug[e.artist]} venue={venueById[e.venue]} hideVenue />
            ))}
          </div>
        ) : (
          <p class="body-medium muted">暂时没有已公布的演出。</p>
        )
      }
    </section>

    {
      sameCity.length > 0 && (
        <section class="section">
          <h2 class="headline-small">{venue.cityZh}的其他场馆</h2>
          <md-chip-set>
            {sameCity.map((v) => (
              <md-assist-chip label={`${v.name} · ${events.filter((e) => e.venue === v.id).length} 场`} href={`/venues/${v.id}`}>
                <md-icon slot="icon" class="material-symbols-rounded">stadium</md-icon>
              </md-assist-chip>
            ))}
          </md-chip-set>
        </section>
      )
    }
  </div>

  <script
    type="application/json"
    id="venue-map-data"
    set:html={JSON.stringify({ venues: nearby, counts, center: [venue.lng, venue.lat], current: venue.id })}
  />
</BaseLayout>

<script>
  const data = JSON.parse(document.getElementById('venue-map-data')!.textContent!);
  import('../../scripts/map').then(({ createVenueMap }) => {
    const api = createVenueMap({
      container: document.getElementById('venue-map')!,
      venues: data.venues,
      counts: data.counts,
      center: data.center,
      zoom: 13.5,
      cooperative: true,
      showEmpty: true,
    });
    api.map.once('load', () => api.highlight(data.current));
  });
</script>

<style>
  .page {
    max-width: 1000px;
    padding-top: 16px;
  }
  .head {
    margin: 8px 0 20px;
  }
  .type {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    border-radius: var(--lv-shape-full);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
  .type .material-symbols-rounded {
    font-size: 18px;
  }
  .head h1 {
    margin: 10px 0 0;
  }
  .local {
    margin: 2px 0 0;
    color: var(--md-sys-color-on-surface-variant);
  }
  .where {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 6px 0 0;
  }
  .where .material-symbols-rounded {
    color: var(--md-sys-color-primary);
  }
  .where a {
    text-decoration: none;
  }
  .where a:hover {
    color: var(--md-sys-color-primary);
    text-decoration: underline;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 16px;
  }
  .map {
    min-height: 320px;
  }
  .facts {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 20px;
    border-radius: var(--lv-shape-xl);
    background: var(--md-sys-color-surface-container-low);
  }
  .facts dt {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--md-sys-color-on-surface-variant);
  }
  .facts dt .material-symbols-rounded {
    font-size: 18px;
    color: var(--md-sys-color-primary);
  }
  .facts dd {
    margin: 2px 0 0 24px;
    font-size: 15px;
  }
  .seat-layouts {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--md-sys-color-on-surface-variant);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .section {
    margin-top: 32px;
  }
  .section h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
  }
  .count {
    padding: 2px 10px;
    border-radius: var(--lv-shape-full);
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }
  .events {
    display: grid;
    gap: 2px;
  }
  .muted {
    color: var(--md-sys-color-on-surface-variant);
  }
  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .map {
      min-height: 240px;
    }
  }
</style>
