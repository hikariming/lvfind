---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventRow from '../../components/EventRow.astro';
import { env } from 'cloudflare:workers';
import { getData } from '../../lib/db';
import { regions, venueTypes } from '../../data/events';
import { dateBlock, fullDate, statusMeta } from '../../lib/format';

const { artistBySlug, venueById, events } = await getData(env.DB);
const event = events.find((e) => String(e.id) === Astro.params.id);
if (!event) return Astro.redirect('/404');

const artist = artistBySlug[event.artist];
const venue = venueById[event.venue];
const d = dateBlock(event.startLocal);
const status = statusMeta[event.ticketStatus];
const others = events
  .filter((e) => e.artist === event.artist && e.id !== event.id)
  .sort((a, b) => a.startLocal.localeCompare(b.startLocal));
const [, vm, vd] = event.verifiedAt.split('-').map(Number);
---

<BaseLayout title={`${artist.nameOriginal} · ${venue.cityZh} ${event.startLocal.slice(0, 10)} | lvfind`}>
  <div class="container detail">
    <md-text-button href="/" class="back">
      <md-icon slot="icon" class="material-symbols-rounded">arrow_back</md-icon>返回列表
    </md-text-button>

    <article class="panel">
      <div class="panel__head">
        <div class="date" style={`view-transition-name: date-${event.id}`}>
          <span class="date__day">{d.day}</span>
          <span class="date__month">{d.month}</span>
          <span class="date__weekday">{d.weekday}</span>
        </div>
        <div>
          <span class={`status status--${event.ticketStatus}`}>
            <span class="material-symbols-rounded">{status.icon}</span>{status.label}
          </span>
          <h1 class="display-small artist" style={`view-transition-name: artist-${event.id}`}>
            <a class="artist-link" href={`/artist/${artist.slug}`}>{artist.nameOriginal}</a>
            {artist.nameLocal && <span class="local">{artist.nameLocal}</span>}
          </h1>
          <p class="body-large tour">{event.tourName}</p>
        </div>
      </div>

      <md-divider></md-divider>

      <dl class="facts">
        <div>
          <dt class="label-medium"><span class="material-symbols-rounded">event</span>时间（当地）</dt>
          <dd class="body-large">{fullDate(event.startLocal)} <span class="tz">{venue.tzAbbr}</span></dd>
        </div>
        <div>
          <dt class="label-medium"><span class="material-symbols-rounded">location_on</span>城市</dt>
          <dd class="body-large">{venue.cityZh} · {regions[venue.countryCode]}</dd>
        </div>
        {
          event.onSaleLocal && (
            <div>
              <dt class="label-medium"><span class="material-symbols-rounded">alarm</span>开售时间（当地）</dt>
              <dd class="body-large">{fullDate(event.onSaleLocal)}</dd>
            </div>
          )
        }
        <div>
          <dt class="label-medium"><span class="material-symbols-rounded">verified</span>信息核对</dt>
          <dd class="body-large">最近核对于 {vm} 月 {vd} 日</dd>
        </div>
      </dl>

      <div class="actions">
        {
          event.ticketUrl && (
            <md-filled-button href={event.ticketUrl} target="_blank">
              <md-icon slot="icon" class="material-symbols-rounded">confirmation_number</md-icon>票务页面
            </md-filled-button>
          )
        }
        <md-outlined-button href={event.sourceUrl} target="_blank">
          <md-icon slot="icon" class="material-symbols-rounded">open_in_new</md-icon>官方公告
        </md-outlined-button>
      </div>
    </article>

    <a class="venue-card" href={`/venues/${venue.id}`}>
      <md-ripple></md-ripple>
      <span class="venue-card__icon"><span class="material-symbols-rounded">stadium</span></span>
      <span class="venue-card__body">
        <span class="title-medium">{venue.name}</span>
        {venue.nameLocal && <span class="body-medium sub">{venue.nameLocal}</span>}
        <span class="body-medium sub"><span class="material-symbols-rounded">train</span>{venue.transit}</span>
        <span class="label-medium sub">容量约 {venue.capacity.toLocaleString('zh-CN')} 人 · {venueTypes[venue.type]}</span>
      </span>
      <span class="material-symbols-rounded venue-card__go">chevron_right</span>
    </a>

    {
      others.length > 0 && (
        <section class="others">
          <h2 class="headline-small">{artist.nameOriginal} 的其他场次</h2>
          <div class="others__list">
            {others.map((o) => (
              <EventRow event={o} artist={artist} venue={venueById[o.venue]} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .detail {
    max-width: 760px;
    padding-top: 16px;
  }
  .back {
    margin-bottom: 12px;
  }
  .panel {
    padding: 24px;
    border-radius: var(--lv-shape-xl);
    background: var(--md-sys-color-surface-container-low);
  }
  .panel__head {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-bottom: 20px;
  }
  .date {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 120px;
    border-radius: 28px;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .date__day {
    font-size: 44px;
    line-height: 46px;
    font-weight: 800;
  }
  .date__month {
    font-weight: 800;
    letter-spacing: 2px;
  }
  .date__weekday {
    font-size: 13px;
    opacity: 0.85;
  }
  .artist {
    margin: 8px 0 4px;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 12px;
  }
  .artist-link {
    text-decoration: none;
  }
  .artist-link:hover {
    color: var(--md-sys-color-primary);
  }
  .artist .local {
    font-size: 18px;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
  }
  .tour {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
  }
  .facts {
    display: grid;
    gap: 16px;
    margin: 20px 0;
  }
  .facts dt {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--md-sys-color-on-surface-variant);
  }
  .facts dt .material-symbols-rounded {
    font-size: 18px;
    color: var(--md-sys-color-primary);
  }
  .facts dd {
    margin: 2px 0 0 24px;
  }
  .tz,
  .sub {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .others {
    margin-top: 32px;
  }
  .others__list {
    display: grid;
    gap: 2px;
    margin-top: 12px;
  }
  .venue-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
    padding: 16px 20px;
    border-radius: var(--lv-shape-xl);
    background: var(--md-sys-color-surface-container-low);
    text-decoration: none;
  }
  .venue-card__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 18px;
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
  }
  .venue-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .venue-card__body .sub {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .venue-card__body .material-symbols-rounded {
    font-size: 16px;
    color: var(--md-sys-color-primary);
  }
  .venue-card__go {
    color: var(--md-sys-color-on-surface-variant);
    transition: transform 0.4s var(--lv-motion-spring);
  }
  .venue-card:hover .venue-card__go {
    transform: translateX(4px);
  }
  @media (max-width: 600px) {
    .panel__head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
